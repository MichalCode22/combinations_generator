@CombinationsGenerator.Api_HostAddress = http://localhost:5080

### Start a session
POST {{CombinationsGenerator.Api_HostAddress}}/api/combinations/start
Content-Type: application/json

{
  "n": 3
}

### Advance the active session (set X-Session-Id to the returned sessionId)
POST {{CombinationsGenerator.Api_HostAddress}}/api/combinations/next
X-Session-Id: {{sessionId}}

### Read the current permutation
GET {{CombinationsGenerator.Api_HostAddress}}/api/combinations/current
X-Session-Id: {{sessionId}}

### Enter and read a page of all remaining permutations
GET {{CombinationsGenerator.Api_HostAddress}}/api/combinations/all?pageSize=2&page=1&enter=true
X-Session-Id: {{sessionId}}

### Reset the active session
DELETE {{CombinationsGenerator.Api_HostAddress}}/api/combinations
X-Session-Id: {{sessionId}}
